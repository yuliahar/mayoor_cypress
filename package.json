{
	"name": "mayoor",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"cy:open:dev": "cypress open --e2e --env configFile=development",
		"cy:open:dev:chrome": "cypress open --e2e --browser chrome --env configFile=development",
		"cy:run:dev": "cypress run --env configFile=development",
		"cy:open:qa": "cypress open --e2e --env configFile=qa",
		"cy:run:qa": "npx cypress run --env configFile=qa",
		"prepare": "husky install",
		"format": "prettier --config .prettierrc --write '**/*.{js,json,md}'",
		"format:check": "prettier --config .prettierrc --check '**/*.{js,json,md}'",
		"lint": "eslint --quiet --fix",
		"lint:check": "eslint '**/*.js'",
		"generate:prisma": "prisma generate",
		"clean:reports": "rm -R -f cypress/reports && mkdir cypress/reports",
		"pretest": "npm run clean:reports",
		"test": "npm run cy:run:qa"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@faker-js/faker": "^7.6.0",
		"@prisma/client": "^4.10.1",
		"bcrypt": "^5.1.0",
		"colors": "^1.4.0",
		"cypress": "^12.6.0",
		"cypress-map": "^1.10.0",
		"cypress-mochawesome-reporter": "^3.3.0",
		"cypress-multi-reporters": "^1.6.2",
		"cypress-plugin-api": "^2.10.0",
		"del": "^7.0.0",
		"dotenv": "^16.0.3",
		"eslint": "^8.32.0",
		"eslint-config-prettier": "^8.6.0",
		"eslint-plugin-cypress": "^2.12.1",
		"eslint-plugin-mocha": "^10.1.0",
		"eslint-plugin-prettier": "^4.2.1",
		"fs-extra": "^11.1.0",
		"husky": "^8.0.0",
		"joi": "^17.8.1",
		"lodash": "^4.17.21",
		"mochawesome": "^7.1.3",
		"mochawesome-merge": "^4.2.2",
		"mochawesome-report-generator": "^6.2.0",
		"mongoose": "^6.9.1",
		"nexus-prisma": "^2.0.8",
		"prettier": "^2.8.3",
		"prisma": "^4.10.1"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{js,json,md}": [
			"npm run lint",
			"npm run format",
			"git add"
		]
	}
}
